# ==============================================================================
# DATA & MACHINE LEARNING SPECIFIC (Наборы данных и ML-артефакты)
# ==============================================================================
# Папки с сырыми, обработанными и промежуточными данными
data/
datasets/
*data.csv
*.jsonl

# Большие файлы моделей, весов и чекпоинтов
*.pth
*.pt
*.onnx
*.pkl
*.pickle
*.h5
*.joblib
*.ckpt
*.dvc

# Папки для сохранения результатов обучения, логов и чекпоинтов
models/
checkpoints/
runs/
outputs/
lightning_logs/

# TensorBoard и логи экспериментов
.tensorboard/
*.log

# ==============================================================================
# JUPYTER NOTEBOOKS (Рабочие тетради)
# ==============================================================================
# Чекпоинты блокнотов и временные файлы
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.virtual_documents/

# Опционально: если вы не хотите коммитить сгенерированные графики HTML
# *.html

# ==============================================================================
# PYTHON SPECIFIC (Стандартный Python)
# ==============================================================================
# Кэш компиляции
__pycache__/
*.py[cod]
*$py.class

# Расширения C
*.so

# Распределения и пакеты
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# VIRTUAL ENVIRONMENTS (Виртуальные окружения)
# ==============================================================================
# Исключаем локальные среды разработки
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# CONFIG & SECRETS (Конфигурации и секреты)
# ==============================================================================
# Переменные окружения с API-ключами (например, к Hugging Face, OpenAI, WandB)
.env
.env.*
!.env.example
secrets.yaml

